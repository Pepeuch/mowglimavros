+  bool wanted_arm_{false}, armed_{false}, connected_{false}, safety_disarm_{false};
+  bool force_disarm_{false}, mode_failed_{false}, arm_failed_{false}, acked_{false};
+  uint64_t serial_{0};
+  int64_t sent_at_{0};
+  std::optional<Command> pending_;
+};
