diff --git a/ros2/src/mowgli_mavros_bridge/include/mowgli_mavros_bridge/fcu_session_controller.hpp b/ros2/src/mowgli_mavros_bridge/include/mowgli_mavros_bridge/fcu_session_controller.hpp
