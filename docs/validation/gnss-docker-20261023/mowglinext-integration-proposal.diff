--- /dev/null
+++ b/sensors/mavros/verify_image_pair.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Proposal only: no caller executes this automatically in this delivery.
+# Extract by digest; never run an image's hardware entrypoint.
+set -euo pipefail
+pair=$1
+canonical_source=$2
+expected_mowgli_revision=$3
+arch=$4
+output=$5
+[[ "$arch" == amd64 || "$arch" == arm64 ]]
+[[ "$expected_mowgli_revision" =~ ^[0-9a-f]{40}$ ]]
+mkdir -p "$output"
+refs=$(python3 - "$pair" <<'PY'
+import json,re,sys
+p=json.load(open(sys.argv[1]))
+for role in ('mavros','mowgli'):
+    ref=p.get(role+'_image') or ''
+    if not re.fullmatch(r'ghcr\.io/[a-z0-9_./-]+@sha256:[0-9a-f]{64}',ref):
+        raise SystemExit('GNSS RELEASE PAIR BLOCKED: missing immutable '+role+' image')
+    print(ref)
+if not re.fullmatch(r'[0-9a-f]{40}',p.get('mavros_commit') or ''):
+    raise SystemExit('GNSS RELEASE PAIR BLOCKED: missing sidecar source commit')
+PY
+)
+mapfile -t images <<< "$refs"
+containers=()
+cleanup() {
+  for container in "${containers[@]}"; do docker rm "$container" >/dev/null || true; done
+}
+trap cleanup EXIT
+for i in 0 1; do
+  if [[ $i == 0 ]]; then role=mavros; else role=mowgli; fi
+  image=${images[$i]}
+  docker pull --platform "linux/$arch" "$image"
+  docker image inspect "$image" > "$output/$role-image-inspect.json"
+  container=$(docker create --platform "linux/$arch" --network none --read-only --entrypoint /bin/false "$image")
+  containers+=("$container")
+  mkdir -p "$output/$role"
+  docker cp "$container:/ros2_ws/install/mowgli_interfaces" "$output/$role/"
+done
+python3 - "$pair" "$expected_mowgli_revision" "$output" "$arch" <<'PY'
+import json,sys
+from pathlib import Path
+pair=json.load(open(sys.argv[1])); out=Path(sys.argv[3])
+for role,revision in [('mavros',pair['mavros_commit']),('mowgli',sys.argv[2])]:
+    doc=json.loads((out/(role+'-image-inspect.json')).read_text())[0]
+    assert doc['Architecture']==sys.argv[4], 'Image architecture mismatch'
+    assert doc['Config']['Labels']['org.opencontainers.image.revision']==revision, 'Source revision mismatch'
+PY
+python3 "$(dirname "$0")/check_image_pair.py" \
+  --canonical-source "$canonical_source" \
+  --mavros-prefix "$output/mavros/mowgli_interfaces" \
+  --mowgli-prefix "$output/mowgli/mowgli_interfaces" --pair "$pair" \
+  | tee "$output/gnss-pair-contract.json"
