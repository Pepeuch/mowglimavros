+#!/usr/bin/env python3
+"""Offline gate for artifacts extracted from an immutable GNSS image pair.
+
+The CI wrapper must extract by digest without executing either entrypoint.
+This checks generated types and their canonical source, not OCI labels alone.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+REQUIRED = {
+    'msg/Emergency.msg', 'msg/GnssStatus.msg', 'msg/HighLevelStatus.msg',
+    'msg/Power.msg', 'msg/Status.msg', 'msg/WheelTick.msg',
+    'srv/EmergencyStop.srv', 'srv/MowerControl.srv',
+}
+IMAGE = re.compile(r'^ghcr\.io/[a-z0-9_./-]+@sha256:[0-9a-f]{64}$')
+
+
+def check(source, mavros, mowgli, pair):
+    for role in ('mavros', 'mowgli'):
+        if not IMAGE.fullmatch(pair.get(role + '_image') or ''):
+            raise ValueError(role + ' image must have an immutable registry digest')
+    lock = json.loads((mavros / 'share/mowgli_interfaces/interface-contract.lock.json').read_text())
+    if set(lock.get('interfaces', {})) != REQUIRED or set(lock.get('type_hashes', {})) != REQUIRED:
+        raise ValueError('sidecar must qualify all eight public interfaces')
+    for relative in sorted(REQUIRED):
+        if hashlib.sha256((source / relative).read_bytes()).hexdigest() != lock['interfaces'][relative]:
+            raise ValueError('canonical source mismatch: ' + relative)
+        stem = str(Path(relative).with_suffix(''))
+        expected = lock['type_hashes'][relative]
+        if not re.fullmatch(r'RIHS01_[0-9a-f]{64}', expected):
+            raise ValueError('invalid locked type hash')
+        for role, prefix in (('mavros', mavros), ('mowgli', mowgli)):
+            doc = json.loads((prefix / 'share/mowgli_interfaces' / (stem + '.json')).read_text())
+            actual = [h['hash_string'] for h in doc['type_hashes'] if h['type_name'] == 'mowgli_interfaces/' + stem]
+            if actual != [expected]:
+                raise ValueError(role + ' generated type mismatch: ' + relative)
+    return lock['type_hashes']
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    for name in ('canonical-source', 'mavros-prefix', 'mowgli-prefix', 'pair'):
+        parser.add_argument('--' + name, type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = check(args.canonical_source, args.mavros_prefix, args.mowgli_prefix,
+                       json.loads(args.pair.read_text()))
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        print('GNSS RELEASE PAIR BLOCKED:', error)
+        return 1
+    print(json.dumps({'interfaces': result, 'software_contract': 'PASS',
+                      'physical_acceptance': 'HARDWARE_REQUIRED'}, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
