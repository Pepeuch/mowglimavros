<?xml version="1.0"?>
<package format="3">
  <name>mavros_battery_observer</name>
  <version>0.1.0</version>
  <description>MAVROS POWER1/POWER2 adapter publishing canonical Mowgli power state.</description>
  <maintainer email="pepeuch@gmail.com">You</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>mavlink</depend>
  <depend>mavros</depend>
  <depend>mavros_msgs</depend>
  <depend>mowgli_interfaces</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <mavros plugin="${prefix}/mavros_plugins.xml" />
  </export>
</package>
