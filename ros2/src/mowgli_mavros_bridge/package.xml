<?xml version="1.0"?>
<package format="3">
  <name>mowgli_mavros_bridge</name>
  <version>0.1.0</version>
  <description>MAVROS/Pixhawk hardware bridge for Mowgli</description>

  <maintainer email="pepeuch@gmail.com">You</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>mowgli_interfaces</depend>
  <depend>mavros</depend>
  <depend>libmavconn</depend>
  <depend>mavlink</depend>
  <depend>mavros_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros_battery_observer</exec_depend>
  <exec_depend>mavros_gnss_adapter</exec_depend>
  <exec_depend>universal_gnss_mavros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>mavros_gnss_adapter</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>universal_gnss_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
